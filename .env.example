# 复制本文件为 .env，然后填入你自己的 API Key（.env 已被 .gitignore 忽略）
DSH_API_KEY=sk-your-key-here

# 以下均为可选配置
# 兼容任何 OpenAI 风格接口；默认使用 DeepSeek 官方接口
DSH_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-chat

# 搜索源：auto（Bing → DuckDuckGo 自动回退）、ddg、bing、searxng
DSH_SEARCH_BACKEND=auto
# 自建 SearXNG 实例地址（DSH_SEARCH_BACKEND=searxng 时必填）
# DSH_SEARXNG_URL=http://localhost:8080

# Agent 单轮最多调用模型的次数
# DSH_MAX_STEPS=8
# 网络请求超时（秒）
# DSH_TIMEOUT=30
# web_fetch 返回正文的最大字符数（500-50000）
# DSH_MAX_FETCH_CHARS=12000
# web_fetch 单次下载上限（字节）
# DSH_MAX_DOWNLOAD_BYTES=2000000
# 允许访问 localhost / 内网地址（仅本地调试时开启）
# DSH_ALLOW_PRIVATE_NETWORK=0
